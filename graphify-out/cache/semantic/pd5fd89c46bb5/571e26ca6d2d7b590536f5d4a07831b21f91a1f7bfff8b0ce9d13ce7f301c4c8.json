{"nodes": [{"id": "design_systems_library_sanity_design_system", "label": "Design System Inspired by Sanity", "file_type": "concept", "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_sanity_category", "label": "Backend & Data (Design Category)", "file_type": "concept", "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_sanity_color_palette", "label": "Sanity Color Palette", "file_type": "concept", "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure achromatic gray scale (#0b0b0b to #ffffff) with no warm or cool bias provides disciplined neutrality against which vivid accent punctuation (neon green, electric blue #0052ef, coral-red #f36458) reads as signal lights in a dark control room."}, {"id": "design_systems_library_sanity_typography", "label": "Sanity Typography System", "file_type": "concept", "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_sanity_waldenburgnormal_typeface", "label": "waldenburgNormal (Display/Body Typeface)", "file_type": "concept", "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single custom typeface used across editorial display and functional UI with extreme negative tracking at scale (-4.48px at 112px), giving headlines a precision-engineered, machined quality."}, {"id": "design_systems_library_sanity_colorimetric_depth_system", "label": "Colorimetric Depth System", "file_type": "concept", "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elevation is communicated almost entirely through surface-color shifts (#0b0b0b -> #212121 -> #353535 -> #ffffff) rather than drop shadows, since traditional shadows are native to light interfaces and would be ineffective on dark surfaces; paired with a universal electric-blue hover across all interactive elements."}], "edges": [{"source": "design_systems_library_sanity_design_system", "target": "design_systems_library_sanity_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sanity_design_system", "target": "design_systems_library_sanity_color_palette", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sanity_design_system", "target": "design_systems_library_sanity_typography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sanity_design_system", "target": "design_systems_library_sanity_colorimetric_depth_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sanity/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sanity_typography", "target": "design_systems_library_sanity_waldenburgnormal_typeface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-sys