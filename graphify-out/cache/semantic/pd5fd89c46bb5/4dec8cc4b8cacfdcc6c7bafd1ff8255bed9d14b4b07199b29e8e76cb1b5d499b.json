{"nodes": [{"id": "design_systems_library_runwayml_design_system", "label": "Design System Inspired by Runway", "file_type": "concept", "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_runwayml_category", "label": "AI & LLM (Design Category)", "file_type": "concept", "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_runwayml_color_palette", "label": "Runway Color Palette", "file_type": "concept", "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The interface is intentionally colorless -- dark-dominant with cool-toned neutrals (#767d88, #7d848e) and zero shadows -- so that AI-generated cinematic photography supplies all color and visual richness."}, {"id": "design_systems_library_runwayml_typography", "label": "Runway Typography System", "file_type": "concept", "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_runwayml_abcnormal_typeface", "label": "abcNormal (Universal Typeface)", "file_type": "concept", "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single geometric sans-serif handles every text role from 48px display to 11px micro tags, achieving variety through size, weight, case, and letter-spacing rather than font switching."}, {"id": "design_systems_library_runwayml_cinematic_photography_ui", "label": "Cinematic Full-Bleed Photography as UI", "file_type": "concept", "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-bleed AI-generated and AI-enhanced imagery IS the primary UI element rather than icons or diagrams; the interface retreats into near-invisibility (minimal borders, zero shadows) so photography dominates."}], "edges": [{"source": "design_systems_library_runwayml_design_system", "target": "design_systems_library_runwayml_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_runwayml_design_system", "target": "design_systems_library_runwayml_color_palette", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_runwayml_design_system", "target": "design_systems_library_runwayml_typography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_runwayml_design_system", "target": "design_systems_library_runwayml_cinematic_photography_ui", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_runwayml_typography", "target": "design_systems_library_runwayml_abcnormal_typeface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_runwayml_design_system", "target": "design_systems_library_shopify_design_system", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "design-systems/library/runwayml/DESIGN.md", "source_location": null, "weight": 1.0, "note": "Both are dark-first designs that use theatrical whitespace and let full-bleed cinematic photography/ultralight typography carry visual richness instead of decorative color."}], "hyperedges": []}