{
  "expo": {
    "name": "Kocum Benim",
    "slug": "KocumBenimMobileApp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#FDE8D0",
    "primaryColor": "#B94718",
    "scheme": "kocumbenimmobileapp",
    "userInterfaceStyle": "light",
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FDE8D0",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.triworkster.kocumbenimmobileapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDE8D0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Takıldığın soruyu fotoğraflayabilmen için kameraya erişmemiz gerekiyor.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8A4A27",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.reactnativegooglesignin.** { *; }\n-keep class com.google.android.gms.auth.** { *; }\n-keep class com.google.android.gms.common.** { *; }\n-keep class com.revenuecat.purchases.** { *; }\n-keep class com.android.billingclient.** { *; }\n-keep class io.invertase.googlemobileads.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-dontwarn com.google.errorprone.annotations.**"
          },
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "./plugins/with-notification-large-icon",
        {
          "icon": "./assets/images/notification-large-icon.png"
        }
      ],
      "./plugins/with-hardware-features",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4455914992803909~7764190271",
          "iosAppId": "ca-app-pub-4455914992803909~6345051417"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.437940693097-avtqiuecbkmvg75je3k1cohm5bo1s1ss"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.triworkster.kocumbenim",
      "appleTeamId": "3RRAH7Q65B",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Koçum Benim",
        "GADApplicationIdentifier": "ca-app-pub-4455914992803909~6345051417",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Takıldığın soru ve ödevlerin fotoğrafını çekip koçuna gönderebilmen için kameraya erişim izni gereklidir.",
        "NSPhotoLibraryUsageDescription": "Takıldığın soruları galerinden seçip sisteme yükleyebilmen için fotoğraf arşivine erişim izni gereklidir.",
        "NSPhotoLibraryAddUsageDescription": "Çözülen soruları ve çalışma notlarını cihazına kaydedebilmen için fotoğraf arşivine kayıt izni gereklidir.",
        "SKAdNetworkItems": [
