{"nodes": [{"id": "design_systems_library_raycast_design_system", "label": "Design System Inspired by Raycast", "file_type": "concept", "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_raycast_category", "label": "Developer Tools (Design Category)", "file_type": "concept", "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_raycast_color_palette", "label": "Raycast Color Palette", "file_type": "concept", "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near-black blue-tinted background (#07080a), not pure black, creates the feel of a native macOS application rather than a website; Raycast Red is used sparingly as punctuation, not a dominant color."}, {"id": "design_systems_library_raycast_typography", "label": "Raycast Typography System", "file_type": "concept", "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_raycast_inter_typeface", "label": "Inter (with OpenType Features)", "file_type": "concept", "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used everywhere with extensive OpenType features (calt, kern, liga, ss03) and unusual positive letter-spacing (+0.2px to +0.4px) on a dark background to keep text airy and readable."}, {"id": "design_systems_library_raycast_macos_shadow_system", "label": "macOS-Native Layered Shadow System", "file_type": "concept", "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-layer box-shadows with inset highlights simulate physical depth (glass/brushed metal) rather than flat rectangles, borrowed from macOS window chrome to reinforce the desktop-utility feel."}], "edges": [{"source": "design_systems_library_raycast_design_system", "target": "design_systems_library_raycast_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_raycast_design_system", "target": "design_systems_library_raycast_color_palette", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_raycast_design_system", "target": "design_systems_library_raycast_typography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_raycast_design_system", "target": "design_systems_library_raycast_macos_shadow_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_raycast_typography", "target": "design_systems_library_raycast_inter_typeface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/raycast/DESIGN.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "dark_canvas_developer_tool_pattern", "label": "Dark-Canvas Developer Tool Aesthetic", "nod