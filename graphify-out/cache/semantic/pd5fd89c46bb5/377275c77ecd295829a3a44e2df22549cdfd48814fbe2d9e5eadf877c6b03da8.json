{"nodes": [{"id": "design_systems_library_revolut_design_system", "label": "Design System Inspired by Revolut", "file_type": "concept", "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_revolut_category", "label": "Fintech & Crypto (Design Category)", "file_type": "concept", "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_revolut_color_palette", "label": "Revolut Color Palette", "file_type": "concept", "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marketing surface is deliberately restrained to near-black (#191c1f) and white, reserving the comprehensive --rui-* semantic color tokens (danger, warning, teal, blue, etc.) for the product interface rather than marketing pages."}, {"id": "design_systems_library_revolut_typography", "label": "Revolut Typography System", "file_type": "concept", "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_revolut_aeonik_pro_typeface", "label": "Aeonik Pro (Display Typeface)", "file_type": "concept", "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Geometric grotesque used at 136px weight 500 with aggressive negative tracking (-2.72px) to create billboard-scale fintech headlines that convey authority through size rather than boldness."}, {"id": "design_systems_library_revolut_universal_pill_button_system", "label": "Universal Pill Button System", "file_type": "concept", "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every button (primary, secondary, outlined, ghost) uses 9999px radius with generous padding (14px 32-34px) and zero shadows, so depth comes entirely from dark/light section contrast."}], "edges": [{"source": "design_systems_library_revolut_design_system", "target": "design_systems_library_revolut_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_revolut_design_system", "target": "design_systems_library_revolut_color_palette", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_revolut_design_system", "target": "design_systems_library_revolut_typography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_revolut_design_system", "target": "design_systems_library_revolut_universal_pill_button_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_revolut_typography", "target": "design_systems_library_revolut_aeonik_pro_typeface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/revolut/DESIGN.md", "source_location": null, "weight": 1.0}], "hyperedges": []}