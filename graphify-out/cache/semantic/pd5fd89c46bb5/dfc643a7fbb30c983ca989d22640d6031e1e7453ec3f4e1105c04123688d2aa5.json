{"nodes": [{"id": "design_systems_library_starbucks_design", "label": "Starbucks Design System", "file_type": "document", "source_file": "design-systems/library/starbucks/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm-neutral canvas and calibrated green tiers reference actual caf\u00e9 materials, giving a 'warm confident retail flagship' feel rather than a cold tech palette."}, {"id": "design_systems_library_starbucks_design_sodosans_font", "label": "SoDoSans Typeface", "file_type": "concept", "source_file": "design-systems/library/starbucks/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_starbucks_design_frap_button", "label": "Frap Floating Circular Order Button", "file_type": "concept", "source_file": "design-systems/library/starbucks/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The product's signature elevation move: a persistent floating circular CTA with a layered shadow stack, giving the strongest depth cue in an otherwise whisper-soft shadow system."}, {"id": "design_systems_library_starbucks_design_four_tier_green_system", "label": "Four-Tier Green Brand System", "file_type": "concept", "source_file": "design-systems/library/starbucks/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately avoids a single flat brand green; each of the four greens (Starbucks/Accent/House/Uplift) is mapped to a distinct surface role so the brand doesn't flatten."}], "edges": [{"source": "design_systems_library_starbucks_design", "target": "design_systems_library_starbucks_design_sodosans_font", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/starbucks/DESIGN.