# Firebase Admin credentials are private and must never enter the mobile repo.
# google-services.json is intentionally not ignored: it is the public Android
# build configuration referenced by app.json, not a Service Account key.
firebase-service-account*.json
service-account*.json
*firebase-adminsdk*.json

# local scratch directory
/example/

# generated native folders
/ios
/android

