{"nodes": [{"id": "design_systems_library_resend_design_system", "label": "Design System Inspired by Resend", "file_type": "concept", "source_file": "design-systems/library/resend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_resend_category", "label": "Productivity & SaaS (Design Category)", "file_type": "concept", "source_file": "design-systems/library/resend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_resend_color_palette", "label": "Resend Color Palette", "file_type": "concept", "source_file": "design-systems/library/resend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure black (#000000) canvas treats email infrastructure like a luxury product; icy blue-tinted frost borders (rgba(214,235,253,0.19)) substitute for shadows, which would be invisible on true black."}, {"id": "design_systems_library_resend_typography", "label": "Resend Typography System", "file_type": "concept", "source_file": "design-systems/library/resend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_resend_domaine_display_typeface", "label": "Domaine Display (Klim Type Foundry)", "file_type": "concept", "source_file": "design-systems/library/resend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A serif used at 96px for hero headlines with tight line-height and negative tracking to create magazine-cover-like display text, paired with ABC Favorit for sections and Inter for body in a strict three-font hierarchy."}, {"id": "design_systems_library_resend_frost_border_system", "label": "Frost Border Depth System", "file_type": "concept", "s