{"nodes": [{"id": "design_systems_library_sentry_design_system", "label": "Design System Inspired by Sentry", "file_type": "concept", "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_sentry_category", "label": "Backend & Data (Design Category)", "file_type": "concept", "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_sentry_color_palette", "label": "Sentry Color Palette", "file_type": "concept", "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm purple-black backgrounds (#1f1633, #150f23) replace the typical cool grays of developer tools, paired with a lime-green accent (#c2ef4e) used sparingly for high-visibility CTAs against an otherwise warm-dark palette."}, {"id": "design_systems_library_sentry_typography", "label": "Sentry Typography System", "file_type": "concept", "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_sentry_dammit_sans_typeface", "label": "Dammit Sans (Brand Display Typeface)", "file_type": "concept", "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used only at hero scale (88px, weight 700) to carry Sentry's irreverent brand voice ('Code breaks. Fix it faster.'), while Rubik handles all functional UI text as the workhorse font."}, {"id": "design_systems_library_sentry_inset_tactile_button_shadow", "label": "Inset Tactile Button Shadow System", "file_type": "concept", "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary buttons use inset shadows (rgba(0,0,0,0.1) 0px 1px 3px inset) so they feel pressed INTO the surface, combined with a deep-purple ambient glow that makes content appear to emit its own bioluminescent light."}], "edges": [{"source": "design_systems_library_sentry_design_system", "target": "design_systems_library_sentry_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sentry_design_system", "target": "design_systems_library_sentry_color_palette", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sentry_design_system", "target": "design_systems_library_sentry_typography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sentry_design_system", "target": "design_systems_library_sentry_inset_tactile_button_shadow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_sentry_typography", "target": "design_systems_library_sentry_dammit_sans_typeface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/sentry/DESIGN.md", "source_location": null, "weight": 1.0}], "hyperedges": []}