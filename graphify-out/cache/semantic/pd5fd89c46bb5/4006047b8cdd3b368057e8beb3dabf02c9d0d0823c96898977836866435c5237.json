{"nodes": [{"id": "design_systems_library_shopify_design_system", "label": "Design System Inspired by Shopify", "file_type": "concept", "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_shopify_category", "label": "E-Commerce & Retail (Design Category)", "file_type": "concept", "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_shopify_color_palette", "label": "Shopify Color Palette", "file_type": "concept", "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark-first design with deep forest-teal undertones (not pure black) stages commerce like a cinematic premiere; Neon Green (#36F4A4) is reserved exclusively for focus rings and small high-energy accents."}, {"id": "design_systems_library_shopify_typography", "label": "Shopify Typography System", "file_type": "concept", "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_systems_library_shopify_neuehaasgrotesk_typeface", "label": "NeueHaasGrotesk (Ultralight Display)", "file_type": "concept", "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A refined Helvetica descendant used at monumental scale (96px) but impossibly light weight (330-400) so headlines appear etched in light rather than printed in ink -- the opposite of the bold-display approach most SaaS sites take."}, {"id": "design_systems_library_shopify_ultralight_display_typography", "label": "Ultralight Display Typography at Monumental Scale", "file_type": "concept", "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Featherweight (330-400) display type at 96px creates a paradox of enormous size and delicate stroke, intended to make commerce technology feel like a science-fiction keynote reveal rather than a SaaS pitch."}], "edges": [{"source": "design_systems_library_shopify_design_system", "target": "design_systems_library_shopify_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_shopify_design_system", "target": "design_systems_library_shopify_color_palette", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_shopify_design_system", "target": "design_systems_library_shopify_typography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_shopify_design_system", "target": "design_systems_library_shopify_ultralight_display_typography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_systems_library_shopify_typography", "target": "design_systems_library_shopify_neuehaasgrotesk_typeface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-systems/library/shopify/DESIGN.md", "source_location": null,